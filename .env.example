# Robot identity
ROBOT_NAME=Nova
ROBOT_TEAM=XXXX
ROBOT_YEAR=2027
# Markdown file with detailed mechanism prose, relative to the project root.
ROBOT_MECHANISMS=mechanisms.md
# Markdown file with team history, interests, and passions.
ROBOT_TEAM_PROFILE=team.md
# Balanced profile budget for Qwen 2.5 1.5B: 500 words per file, 1,000 combined.
MAX_PROFILE_WORDS=1000
MAX_MECHANISM_WORDS=500
MAX_TEAM_WORDS=500
ROBOT_TONE=concise, informative, enthusiastic, and conversational

# Offline LLM
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Local speech recognition and synthesis
VOSK_MODEL_PATH=./vosk-model-small-en-us-0.15
INPUT_SAMPLE_RATE=auto
# Use a numeric device index from --list-devices, or default for automatic selection.
INPUT_DEVICE=default
# Stop waiting if the selected source produces no frames.
AUDIO_INPUT_TIMEOUT_SECONDS=5
TTS_BACKEND=espeak
TTS_VOICE=en-us
TTS_SPEED=155
LOG_LEVEL=INFO
MAX_HISTORY_MESSAGES=12
